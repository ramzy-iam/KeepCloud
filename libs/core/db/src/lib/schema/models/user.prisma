model User {
  id        String    @id @default(dbgenerated("nanoid()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  firstName String?
  lastName  String?
  picture   String?
  email     String  @unique

  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  // sharedFiles relation removed - sharing now handled via File.shareToken
  fileAccessLogs FileAccessLog[]  @relation("UserFileAccessLogs")
  ownedFiles     File[]           @relation("FileOwner")
  createdFiles   File[]           @relation("FileCreator")

  storageUsed BigInt @default(0) //in bytes
}
