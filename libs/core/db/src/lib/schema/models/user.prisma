model User {
  id        String    @id @default(dbgenerated("nanoid()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  firstName String?
  lastName  String?
  picture   String?
  email     String  @unique

  planId         String
  plan           SubscriptionPlan @relation(fields: [planId], references: [id])
  fileAccessLogs FileAccessLog[]  @relation("UserFileAccessLogs")
  ownedFiles     File[]           @relation("FileOwner")
  TreeOwnedFiles     File[]           @relation("TreeOwner")
  createdFiles   File[]           @relation("FileCreator")
  
  // File permissions
  filePermissions FilePermission[]
  grantedPermissions FilePermission[] @relation("GrantedBy")

  storageUsed BigInt @default(0) //in bytes
}
