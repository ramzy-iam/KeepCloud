enum FileType {
  FILE
  FOLDER
}

model File {
  id        String    @id @default(dbgenerated("nanoid()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trashedAt DateTime?

  name        String
  contentType String
  isFolder    Boolean  @default(false)
  format      String?
  size        BigInt //in bytes     
  type        FileType @default(FILE)
  isSystem    Boolean  @default(false)

  storagePath String? //null for folders

  parentId String?
  parent   File?   @relation("FileHierarchy", fields: [parentId], references: [id])
  children File[]  @relation("FileHierarchy")

  ownerId String
  owner   User   @relation("FileOwner", fields: [ownerId], references: [id])

  createdById String?
  createdBy   User?   @relation("FileCreator", fields: [createdById], references: [id])

  accessLogs FileAccessLog[] @relation("FileToAccessLog")

  // Simple sharing approach using flags and tokens
  isPublic    Boolean  @default(false)
  isShared    Boolean  @default(false)
  shareToken  String?  @unique // For secure sharing
  shareExpiry DateTime? // Optional expiry for shares

  left       Int
  right      Int

  @@index([left])
  @@index([right])
  @@index([createdById])
  @@index([ownerId])
  @@index([parentId])
  @@index([trashedAt])
  @@index([shareToken])
  @@index([isPublic])
  @@index([isShared])
}
