enum FileType {
  FILE
  FOLDER
}

model File {
  id        String    @id @default(dbgenerated("nanoid()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trashedAt DateTime?

  name        String
  contentType String
  isFolder    Boolean  @default(false)
  format      String?
  size        BigInt //in bytes     
  type        FileType @default(FILE)
  isSystem    Boolean  @default(false)

  storagePath String? //null for folders

  parentId String?
  parent   File?   @relation("FileHierarchy", fields: [parentId], references: [id])
  children File[]  @relation("FileHierarchy")

  // Owner of this specific file/folder (creator or assigned owner)
  ownerId String
  owner   User   @relation("FileOwner", fields: [ownerId], references: [id])

  // Owner of the root folder that controls the entire tree hierarchy
  // Required for all files/folders to scope nested set operations
  treeOwnerId String
  treeOwner   User @relation("TreeOwner", fields: [treeOwnerId], references: [id])

  accessLogs FileAccessLog[] @relation("FileToAccessLog")
  permissions FilePermission[]
  links FileLink[]

  // Nested set model boundaries - scoped by treeOwnerId
  left       Int
  right      Int

  // Critical: Compound index for efficient subtree queries within tree scope
  @@index([treeOwnerId, left, right])
  @@index([treeOwnerId, left])
  @@index([treeOwnerId, right])
  @@index([ownerId])
  @@index([parentId])
  @@index([trashedAt])
  @@index([deletedAt])
}
