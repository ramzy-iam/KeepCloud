enum FileType {
  FILE
  FOLDER
}

model File {
  id        String    @id @default(dbgenerated("nanoid()"))
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trashedAt DateTime?

  name        String
  contentType String
  isFolder    Boolean  @default(false)
  format      String?
  size        BigInt //in bytes     
  type        FileType @default(FILE)
  isSystem    Boolean  @default(false)

  storagePath String? //null for folders

  parentId String?
  parent   File?   @relation("FileHierarchy", fields: [parentId], references: [id])
  children File[]  @relation("FileHierarchy")

  ownerId String
  owner   User   @relation("FileOwner", fields: [ownerId], references: [id])

  treeOwnerId String?
  treeOwner   User? @relation("TreeOwner", fields: [treeOwnerId], references: [id])

  createdById String?
  createdBy   User?   @relation("FileCreator", fields: [createdById], references: [id])

  accessLogs FileAccessLog[] @relation("FileToAccessLog")
  permissions FilePermission[]
  links FileLink[]

  left       Int
  right      Int

  @@index([left])
  @@index([right])
  @@index([createdById])
  @@index([ownerId])
  @@index([parentId])
  @@index([trashedAt])
}
