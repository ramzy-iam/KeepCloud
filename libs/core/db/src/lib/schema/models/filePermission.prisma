enum FilePermissionRole {
  OWNER     // full control (already covered by File.ownerId)
  EDITOR    // can create/update/delete files inside folder
  VIEWER    // read-only
  COMMENTER // optional: read + comment
}


model FilePermission {
  id         String   @id @default(dbgenerated("nanoid()"))
  createdAt  DateTime @default(now())

  // the file/folder being shared
  fileId     String
  file       File @relation(fields: [fileId], references: [id])

  // the user receiving access
  userId     String
  user       User @relation(fields: [userId], references: [id])

  role       FilePermissionRole

  // who granted access
  grantedById String
  grantedBy   User @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([fileId, userId]) // one permission per user per file
  @@index([fileId])
  @@index([userId])
}
