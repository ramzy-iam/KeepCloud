enum FilePermissionRole {
  TREE_OWNER  // full control of tree structure (restructure, move, delete entire subtrees)
  OWNER       // full control of specific file/folder (delete, manage permissions)
  EDITOR      // can create/update/delete files inside folder, cannot restructure tree
  VIEWER      // read-only access
  COMMENTER   // read + comment (optional)
}


model FilePermission {
  id         String   @id @default(dbgenerated("nanoid()"))
  createdAt  DateTime @default(now())

  // the file/folder being shared
  fileId     String
  file       File @relation(fields: [fileId], references: [id])

  // the user receiving access
  userId     String
  user       User @relation(fields: [userId], references: [id])

  role       FilePermissionRole

  // who granted access
  grantedById String
  grantedBy   User @relation("GrantedBy", fields: [grantedById], references: [id])

  @@unique([fileId, userId]) // one permission per user per file
  @@index([fileId])
  @@index([userId])
}
