<mjml>
  <mj-head>
    <mj-title>Welcome to KeepCloud</mj-title>
    <mj-font
      name='Inter'
      href='https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap'
    />
    <mj-attributes>
      <mj-all font-family='Inter, Arial, sans-serif' />
      <mj-text font-size='16px' color='#2e2e37' line-height='1.6' />
      <mj-button
        background-color='#4c3cc6'
        color='#ffffff'
        font-weight='600'
        border-radius='8px'
      />
    </mj-attributes>
    <mj-style inline='inline'>
      .feature-icon { width: 48px; height: 48px; background: #f8f9fa;
      border-radius: 12px; display: inline-flex; align-items: center;
      justify-content: center; margin-bottom: 16px; }
    </mj-style>
  </mj-head>
  <mj-body background-color='#f8f9fa'>
    <!-- Header avec logo et gradient -->
    <mj-section padding='40px 20px' background-color='#2e2e37'>
      <mj-column>
        <mj-image
          src='https://assets-rzlab.s3.eu-west-3.amazonaws.com/keepcloud/images/logomark-3x.png'
          alt='KeepCloud'
          width='60px'
          align='center'
        />
        <mj-spacer height='20px' />
        <mj-text
          align='center'
          color='#ffffff'
          font-size='32px'
          font-weight='700'
          line-height='1.2'
        >
          Welcome to KeepCloud!
        </mj-text>
        <mj-text
          align='center'
          color='#9f9fa3'
          font-size='18px'
          font-weight='400'
        >
          Your secure cloud storage solution is ready
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Message principal -->
    <mj-section background-color='#ffffff' padding='50px 20px'>
      <mj-column>
        <mj-text font-size='18px' color='#2e2e37'>
          Hello
          <strong>{{firstName}}</strong>,
        </mj-text>
        <mj-text>
          We're excited to welcome you to the KeepCloud community! Your account
          has been successfully created and you can now enjoy all our services.
        </mj-text>
        <mj-text>
          KeepCloud offers you secure storage space accessible from anywhere.
          Organize, share and synchronize your files with ease.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Fonctionnalités principales -->
    <mj-section background-color='#ffffff' padding='30px 20px'>
      <mj-column>
        <mj-text
          align='center'
          font-size='24px'
          font-weight='600'
          color='#2e2e37'
          padding-bottom='30px'
        >
          Discover your new possibilities
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color='#ffffff' padding='0 20px 30px'>
      <mj-column width='50%'>
        <mj-text align='center' padding='20px'>
          <table
            align='center'
            cellpadding='0'
            cellspacing='0'
            border='0'
            width='48'
            height='48'
            style='background:#f8f9fa; border-radius:12px; margin:0 auto;'
          >
            <tr>
              <td
                style='font-size:28px; line-height:48px; text-align:center; vertical-align:middle;'
              >
                📁
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text
          align='center'
          font-size='18px'
          font-weight='600'
          color='#2e2e37'
        >
          Smart Organization
        </mj-text>
        <mj-text align='center' font-size='14px' color='#737379'>
          Create folders and organize your files according to your needs
        </mj-text>
      </mj-column>
      <mj-column width='50%'>
        <mj-text align='center' padding='20px'>
          <table
            align='center'
            cellpadding='0'
            cellspacing='0'
            border='0'
            width='48'
            height='48'
            style='background:#f8f9fa; border-radius:12px; margin:0 auto;'
          >
            <tr>
              <td
                style='font-size:28px; line-height:48px; text-align:center; vertical-align:middle;'
              >
                🔒
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text
          align='center'
          font-size='18px'
          font-weight='600'
          color='#2e2e37'
        >
          Maximum Security
        </mj-text>
        <mj-text align='center' font-size='14px' color='#737379'>
          Your data is encrypted and protected at all times
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color='#ffffff' padding='0 20px 40px'>
      <mj-column width='50%'>
        <mj-text align='center' padding='20px'>
          <table
            align='center'
            cellpadding='0'
            cellspacing='0'
            border='0'
            width='48'
            height='48'
            style='background:#f8f9fa; border-radius:12px; margin:0 auto;'
          >
            <tr>
              <td
                style='font-size:28px; line-height:48px; text-align:center; vertical-align:middle;'
              >
                ☁️
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text
          align='center'
          font-size='18px'
          font-weight='600'
          color='#2e2e37'
        >
          Cloud Synchronization
        </mj-text>
        <mj-text align='center' font-size='14px' color='#737379'>
          Access your files from all your devices
        </mj-text>
      </mj-column>
      <mj-column width='50%'>
        <mj-text align='center' padding='20px'>
          <table
            align='center'
            cellpadding='0'
            cellspacing='0'
            border='0'
            width='48'
            height='48'
            style='background:#f8f9fa; border-radius:12px; margin:0 auto;'
          >
            <tr>
              <td
                style='font-size:28px; line-height:48px; text-align:center; vertical-align:middle;'
              >
                🚀
              </td>
            </tr>
          </table>
        </mj-text>
        <mj-text
          align='center'
          font-size='18px'
          font-weight='600'
          color='#2e2e37'
        >
          Simplified Sharing
        </mj-text>
        <mj-text align='center' font-size='14px' color='#737379'>
          Share your files securely with anyone you want
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Call to action -->
    <mj-section background-color='#ffffff' padding='30px 20px 50px'>
      <mj-column>
        <mj-button
          href='{{dashboardUrl}}'
          font-size='16px'
          padding='15px 30px'
          background-color='#4c3cc6'
          border-radius='8px'
        >
          Access my dashboard
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Informations du compte -->
    <mj-section background-color='#f8f9fa' padding='40px 20px'>
      <mj-column>
        <mj-text
          align='center'
          font-size='20px'
          font-weight='600'
          color='#2e2e37'
          padding-bottom='20px'
        >
          Your account information
        </mj-text>

        <mj-table>
          <tr style='border-bottom: 1px solid #e9e9ea'>
            <td
              style='
                padding: 12px 0;
                font-weight: 600;
                color: #58585f;
                width: 120px;
                white-space: nowrap;
              '
            >
              Current Plan:
            </td>
            <td style='padding: 12px 0; color: #2e2e37'>
              {{#if plan}}{{plan}}{{else}}Free Plan{{/if}}
            </td>
          </tr>
          <tr>
            <td
              style='
                padding: 12px 0;
                font-weight: 600;
                color: #58585f;
                width: 120px;
                white-space: nowrap;
              '
            >
              Storage Space:
            </td>
            <td style='padding: 12px 0; color: #2e2e37'>
              {{#if storageLimit}}{{storageLimit}}{{else}}20 MB{{/if}}
              {{#unless plan}}(Free){{/unless}}
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Conseils pour commencer -->
    <mj-section background-color='#ffffff' padding='40px 20px'>
      <mj-column>
        <mj-text
          align='center'
          font-size='20px'
          font-weight='600'
          color='#2e2e37'
          padding-bottom='20px'
        >
          Getting Started
        </mj-text>
        <mj-text font-size='16px' color='#2e2e37'>
          <strong>1. Upload your first files</strong><br />
          <span style='color: #737379'>Drag and drop your documents directly
            into the interface</span>
        </mj-text>
        <mj-spacer height='15px' />
        <mj-text font-size='16px' color='#2e2e37'>
          <strong>2. Create your folders</strong><br />
          <span style='color: #737379'>Organize your space according to your
            projects and needs</span>
        </mj-text>
        <mj-spacer height='15px' />
        <mj-text font-size='16px' color='#2e2e37'>
          <strong>3. Share with your team</strong><br />
          <span style='color: #737379'>Invite your collaborators and work
            together</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Support -->
    <mj-section background-color='#f8f9fa' padding='30px 20px'>
      <mj-column>
        <mj-text align='center' font-size='16px' color='#58585f'>
          Need help? Contact our support team at
          <a
            href='mailto:{{supportEmail}}'
            style='color: #4c3cc6; text-decoration: none; font-weight: 600'
          >
            {{supportEmail}}
          </a>.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color='#2e2e37' padding='30px 20px'>
      <mj-column>
        <mj-image
          src='https://assets-rzlab.s3.eu-west-3.amazonaws.com/keepcloud/images/full-logo-dark-3x.png'
          alt='KeepCloud'
          width='150px'
          align='center'
        />
        <mj-spacer height='20px' />
        <mj-text align='center' color='#9f9fa3' font-size='14px'>
          ©
          {{currentYear}}
          KeepCloud. All rights reserved.
        </mj-text>

        <mj-text align='center' color='#9f9fa3' font-size='12px'>
          <a href='#' style='color: #9f9fa3; text-decoration: underline'>
            Unsubscribe
          </a>
          &nbsp;|&nbsp;
          <a href='#' style='color: #9f9fa3; text-decoration: underline'>
            Privacy Policy
          </a>
          &nbsp;|&nbsp;
          <a href='#' style='color: #9f9fa3; text-decoration: underline'>
            Terms of Service
          </a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>