{
  "name": "keepcloud-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "development",

      "options": {
        "optimization": false,
        "target": "node",
        "compiler": "tsc",
        "main": "apps/api/src/main.ts",
        "outputPath": "dist/apps/api",
        "tsConfig": "apps/api/tsconfig.app.json",
        "webpackConfig": "apps/api/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {
          "main": "apps/api/src/main.prod.ts"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "command": "cross-env NODE_ENV=development node dist/apps/api/main.js"
      },
      "configurations": {
        "development": {},
        "production": {
          "command": "cross-env NODE_ENV=production node dist/apps/api/main.js"
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["coverage/apps/api"],
      "options": {
        "jestConfig": "apps/api/jest.config.ts",
        "passWithNoTests": true
      }
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "serverless package",
        "cwd": "apps/api"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "package"
        }
      ],
      "options": {
        "command": "serverless deploy --package .serverless",
        "cwd": "apps/api"
      }
    }
  }
}
