{
  "name": "keepcloud-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "serverless package",
        "cwd": "apps/web"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "target": "package"
        }
      ],
      "options": {
        "command": "serverless deploy --package .serverless --verbose",
        "cwd": "apps/web"
      }
    }
  }
}
